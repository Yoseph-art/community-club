// Daily keep-alive for the club's Supabase project (see keepalive.js). No web address of its own.
{
  "name": "cc-keepalive",
  "main": "keepalive.js",
  "compatibility_date": "2026-10-01",
  "no_bundle": true,
  "workers_dev": false,
  "preview_urls": false,
  // every day at 06:23 UTC (09:23 in Uganda)
  "triggers": { "crons": ["23 6 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "DB_URL": "FILL_IN",
    // the publishable key: public by design, the same one the app uses
    "DB_KEY": "FILL_IN"
  }
}
